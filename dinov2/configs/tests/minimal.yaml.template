compute_precision: bf16
dino:
  loss_weight: 1.0
  head_n_prototypes: 65536
  head_bottleneck_dim: 256
  head_nlayers: 3
  head_hidden_dim: 2048
  koleo_loss_weight: 0.1
ibot:
  loss_weight: 1.0
  mask_sample_probability: 0.5
  mask_ratio_min_max:
  - 0.1
  - 0.5
  separate_head: false
  head_n_prototypes: 65536
  head_bottleneck_dim: 256
  head_nlayers: 3
  head_hidden_dim: 2048
train:
  grad_accum_steps: 1
  batch_size_per_gpu: 16
  batch_size_total: 16
  output_dir: .
  seed: 0
  num_workers: 10
  iterations_per_epoch: 1000
checkpoints:
  print_iterations: 10
  save_checkpoint_iterations: 1000
  save_teacher_iterations: 10000
student:
  model_name: vitb14_3d
  pretrained_weights: ''
  embed_dim: 768
  depth: 12
  num_heads: 12
  mlp_ratio: 4
  embed_layer:
    type: patch_3d
    patch_size: 14
    img_size: 448
    layer_norm: false
  drop_path_rate: 0.0
  layerscale: 1.0e-05
  drop_path_uniform: true
  ffn_layer: "mlp"
  qkv_bias: true
  proj_bias: true
  ffn_bias: true
  num_register_tokens: 4
datasets:
  - name: default_dataset
    weight: 1.0
    index_path: .
    type: ct
    storage: dicom
    bounds: [-1000.0, 1900.0] 
    norm:
      mean: -573.8
      std: 461.3